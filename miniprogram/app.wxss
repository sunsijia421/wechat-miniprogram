/* 佳禾换物小站 - 全局样式 v2 */

page {
  background-color: #F6F7F9;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  color: #1D2129;
  -webkit-font-smoothing: antialiased;
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
}

/* 通用容器 */
.container {
  min-height: 100%;
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4CAF50 0%, #43A047 100%);
  color: #ffffff;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 16px;
  font-weight: 600;
  text-align: center;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 20rpx rgba(76, 175, 80, 0.28);
  transition: transform 0.12s ease, opacity 0.12s ease, box-shadow 0.12s ease;
}

.btn-primary:active {
  opacity: 0.88;
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.2);
}

.btn-outline {
  background-color: transparent;
  color: #4CAF50;
  border: 2rpx solid #4CAF50;
  border-radius: 48rpx;
  padding: 22rpx 46rpx;
  font-size: 16px;
  text-align: center;
}

.btn-danger {
  background: linear-gradient(135deg, #FF6B6B, #EE5A5A);
  color: #ffffff;
  border: none;
  border-radius: 48rpx;
  padding: 18rpx 36rpx;
  font-size: 14px;
  box-shadow: 0 4rpx 12rpx rgba(238, 90, 90, 0.25);
}

.btn-disabled {
  background-color: #E5E6EB;
  color: #86909C;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 16px;
}

/* 通用卡片 */
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  margin: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 33, 41, 0.04);
}

/* 分类标签 */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 12px;
  color: #ffffff;
  font-weight: 500;
}

.tag-books { background-color: #FF9800; }
.tag-clothes { background-color: #2196F3; }
.tag-electronics { background-color: #9C27B0; }
.tag-other { background-color: #607D8B; }

/* 状态标签 */
.status-available {
  color: #2E7D32;
  font-size: 12px;
  background-color: #E8F5E9;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-completed {
  color: #86909C;
  font-size: 12px;
  background-color: #F2F3F5;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.status-offline {
  color: #EF6C00;
  font-size: 12px;
  background-color: #FFF3E0;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.status-waiting {
  color: #1565C0;
  font-size: 12px;
  background-color: #E3F2FD;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}

.empty-state .text {
  font-size: 14px;
  color: #86909C;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #F2F3F5;
  margin: 16rpx 0;
}

/* 弹性布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* 文本省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 头像 */
.avatar-sm {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F2F3F5;
}

.avatar-md {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #F2F3F5;
}

.avatar-lg {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #F2F3F5;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx;
  color: #86909C;
  font-size: 13px;
}
