/* 佳禾换物小站 - 全局样式 */

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  color: #333;
  /* 全局防闪烁：GPU 加速 + 避免重排导致的抖动 */
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

/* 通用容器 */
.container {
  min-height: 100%;
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, #43A047, #5CB85C);
  color: #ffffff;
  border: none;
  border-radius: 44rpx;
  padding: 22rpx 44rpx;
  font-size: 16px;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(76, 175, 80, 0.3);
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.btn-outline {
  background-color: transparent;
  color: #4CAF50;
  border: 2rpx solid #4CAF50;
  border-radius: 44rpx;
  padding: 20rpx 42rpx;
  font-size: 16px;
  text-align: center;
}

.btn-danger {
  background-color: #f44336;
  color: #ffffff;
  border: none;
  border-radius: 44rpx;
  padding: 18rpx 34rpx;
  font-size: 14px;
}

.btn-disabled {
  background-color: #cccccc;
  color: #ffffff;
  border: none;
  border-radius: 44rpx;
  padding: 22rpx 44rpx;
  font-size: 16px;
}

/* 通用卡片 */
.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 20rpx;
  padding: 26rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.05);
}

/* 分类标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 12px;
  color: #ffffff;
}

.tag-books { background-color: #FF9800; }
.tag-clothes { background-color: #2196F3; }
.tag-electronics { background-color: #9C27B0; }
.tag-other { background-color: #607D8B; }

/* 状态标签 */
.status-available {
  color: #43A047;
  font-size: 12px;
  background-color: #E8F5E9;
  border: none;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-completed {
  color: #999;
  font-size: 12px;
  background-color: #f0f0f0;
  border: none;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-offline {
  color: #FF9800;
  font-size: 12px;
  background-color: #FFF3E0;
  border: none;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}

.empty-state .text {
  font-size: 14px;
  color: #999;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 16rpx 0;
}

/* 弹性布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* 文本省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 头像 */
.avatar-sm {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
}

.avatar-md {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 13px;
}
