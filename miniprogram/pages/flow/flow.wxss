/* 流向公示页（第二批） */
page {
  background: #f5f5f5;
}
.container {
  padding: 20rpx;
}
.flow-banner {
  background: linear-gradient(135deg, #4caf50, #66bb6a);
  border-radius: 16rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 20rpx;
}
.flow-banner-title {
  font-size: 36rpx;
  font-weight: bold;
}
.flow-banner-desc {
  font-size: 24rpx;
  margin-top: 12rpx;
  opacity: 0.9;
  line-height: 1.5;
}
.flow-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
}
.flow-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #eee;
}
.flow-info { flex: 1; min-width: 0; }
.flow-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.flow-wish {
  font-size: 22rpx;
  color: #e65100;
  background: #fff3e0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}
.flow-meta {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
}
.flow-route {
  margin-top: 10rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}
.flow-donor {
  color: #2e7d32;
  font-weight: bold;
}
.flow-arrow {
  margin: 0 12rpx;
  color: #999;
}
.flow-receiver {
  color: #1565c0;
  font-weight: bold;
}
.flow-thanks {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
}
.flow-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #aaa;
}
.empty {
  text-align: center;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 80rpx;
}
.empty-text {
  margin-top: 20rpx;
  color: #999;
  font-size: 28rpx;
}
