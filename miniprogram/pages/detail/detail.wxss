/* 物品详情页样式 */

/* ========== 图片轮播 ========== */
.image-swiper {
  width: 100%;
  height: 500rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
  background-color: #f0f0f0;
}

.default-image {
  width: 100%;
  height: 500rpx;
  background-color: #f0f0f0;
}

/* ========== 详情内容 ========== */
.detail-content {
  padding-top: 16rpx;
}

/* 游客只读提示横幅 */
.guest-banner {
  margin: 0 20rpx 16rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #E3F2FD, #F1F8E9);
  border: 1rpx solid #BBDEFB;
  border-radius: 16rpx;
  font-size: 13px;
  color: #455A64;
  line-height: 1.6;
}

/* 已下架提示横幅（非发布者） */
.offline-banner {
  margin: 0 20rpx 16rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #FFF3E0, #FFF8E1);
  border: 1rpx solid #FFE0B2;
  border-radius: 16rpx;
  font-size: 13px;
  color: #E65100;
  line-height: 1.6;
}

/* 举报记录 */
.report-reason {
  flex: 1;
  margin-right: 16rpx;
  padding: 10rpx 16rpx;
  background-color: #FFF8F8;
  border-radius: 8rpx;
}

.report-time {
  font-size: 12px;
  color: #bbb;
  margin-top: 8rpx;
}

.report-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.report-action {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 24rpx;
  font-size: 13px;
}

.report-action.danger {
  background-color: #f44336;
  color: #ffffff;
}

.report-action.normal {
  background-color: #f0f0f0;
  color: #666;
}

.detail-header {
  margin-bottom: 0;
}

.detail-title {
  font-size: 20px;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.detail-category {
  margin-top: 12rpx;
}

/* ========== 区块 ========== */
.section-title {
  font-size: 15px;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 14px;
  color: #555;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* ========== 信息行 ========== */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 13px;
  color: #999;
}

.info-value {
  font-size: 13px;
  color: #333;
}

/* 可交换标识 */
.info-value.barter-yes {
  color: #2E7D32;
  font-weight: 600;
}

.info-value.barter-no {
  color: #999;
}

/* ========== 发布者信息 ========== */
.publisher-info {
  display: flex;
  align-items: center;
}

.publisher-detail {
  margin-left: 20rpx;
}

.publisher-name {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.publisher-stats {
  font-size: 12px;
  color: #999;
  margin-top: 8rpx;
}

/* ========== 申请列表 ========== */
.application-list {
  margin-top: 8rpx;
}

.application-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.application-item:last-child {
  border-bottom: none;
}

.app-header {
  margin-bottom: 10rpx;
}

.app-name {
  font-size: 14px;
  font-weight: 500;
  margin-left: 12rpx;
  color: #333;
}

.app-status {
  font-size: 11px;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.app-status-pending {
  background-color: #FFF3E0;
  color: #FF9800;
}

.app-status-approved {
  background-color: #E8F5E9;
  color: #4CAF50;
}

.app-status-rejected {
  background-color: #f5f5f5;
  color: #999;
}

.app-message {
  font-size: 13px;
  color: #666;
  padding: 10rpx 16rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
}

.approve-btn {
  margin-top: 12rpx;
  text-align: center;
  padding: 14rpx 0;
  background: linear-gradient(135deg, #43A047, #5CB85C);
  color: #ffffff;
  border-radius: 30rpx;
  font-size: 13px;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.28);
  transition: transform 0.12s ease;
}

.approve-btn:active {
  transform: scale(0.97);
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 16rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 100;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.bottom-btn {
  flex: 1;
  border-radius: 44rpx;
  font-size: 16px;
  font-weight: bold;
  padding: 24rpx 0;
  box-shadow: 0 6rpx 16rpx rgba(76, 175, 80, 0.3);
}

.bottom-btn:active {
  transform: scale(0.97);
}

.report-btn {
  font-size: 12px;
  color: #ccc;
  padding: 10rpx;
  white-space: nowrap;
}

.btn-danger {
  background-color: #f44336;
  color: #ffffff;
}

/* ========== 弹窗 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 30rpx 30rpx;
  width: 100%;
  max-height: 60vh;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 13px;
  color: #999;
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-textarea {
  width: 100%;
  height: 160rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 14px;
  box-sizing: border-box;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btn-cancel {
  flex: 1;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 30rpx;
  font-size: 15px;
}

.modal-btn-confirm {
  flex: 2;
  background-color: #4CAF50;
  color: #ffffff;
  border-radius: 30rpx;
  font-size: 15px;
}
