<!-- 物品详情页 -->
<view class="container" wx:if="{{item}}">

  <!-- 图片轮播 -->
  <swiper class="image-swiper" wx:if="{{item.images.length > 0}}" indicator-dots="{{true}}" autoplay="{{false}}" circular="{{true}}">
    <swiper-item wx:for="{{item.images}}" wx:key="*this" wx:for-index="index">
      <image class="swiper-image" src="{{item}}" mode="aspectFill"
        data-index="{{index}}" bindtap="previewImage" />
    </swiper-item>
  </swiper>

  <!-- 默认图片 -->
  <view class="default-image" wx:if="{{item.images.length === 0}}">
    <image class="swiper-image" src="/images/default-item.png" mode="aspectFill" />
  </view>

  <!-- 物品信息 -->
  <view class="detail-content">

    <!-- 游客只读提示 -->
    <view class="guest-banner" wx:if="{{!isLoggedIn}}">
      👀 游客模式：当前仅可浏览，登录后可申请/发布物品
    </view>

    <!-- 标题和状态 -->
    <view class="detail-header card">
      <view class="flex-between">
        <view class="detail-title">{{item.title}}</view>
        <view class="status-{{item.status === 'completed' ? 'completed' : (item.status === 'offline' ? 'offline' : 'available')}}">
          {{item.status === 'completed' ? '已被领取' : item.status === 'offline' ? '已下架' : '可领取'}}
        </view>
      </view>
      <view class="tag tag-{{item.category}} detail-category">{{item.categoryName}}</view>
    </view>

    <!-- 描述 -->
    <view class="card">
      <view class="section-title">📝 物品描述</view>
      <view class="section-content">{{item.description}}</view>
    </view>

    <!-- 详细信息 -->
    <view class="card">
      <view class="section-title">📋 详细信息</view>
      <view class="info-row">
        <text class="info-label">分类</text>
        <text class="info-value">{{item.categoryName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">以物易物</text>
        <text class="info-value {{item.allowBarter ? 'barter-yes' : 'barter-no'}}">{{item.allowBarter ? '🔄 可交换' : '❌ 不支持交换'}}</text>
      </view>
      <view class="info-row" wx:if="{{item.locationName}}">
        <text class="info-label">位置</text>
        <text class="info-value">📍 {{item.locationName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">发布时间</text>
        <text class="info-value">{{item.createTimeStr}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">浏览量</text>
        <text class="info-value">👁 {{item.viewCount || 0}} 次浏览</text>
      </view>
    </view>

    <!-- 发布者信息 -->
    <view class="card">
      <view class="section-title">👤 发布者</view>
      <view class="publisher-info">
        <image class="avatar-md" src="{{item.publisherAvatarUrl || '/images/default-item.png'}}" mode="aspectFill" />
        <view class="publisher-detail">
          <view class="publisher-name">{{item.publisherNickName || '匿名'}}</view>
          <view class="publisher-stats" wx:if="{{currentUser}}">
            公益积分: {{currentUser.points}} | 已捐赠: {{currentUser.donateCount}}次
          </view>
        </view>
        <view wx:if="{{isLoggedIn && !isOwner}}" class="follow-btn {{followed ? 'followed' : ''}}" bindtap="toggleFollow">
          {{followed ? '✓ 已关注' : '+ 关注'}}
        </view>
      </view>
    </view>

    <!-- 已下架提示（非发布者） -->
    <view class="offline-banner" wx:if="{{isOffline && !isOwner}}">
      📴 该物品已被发布者下架，暂不可申请
    </view>

    <!-- 申请记录列表（仅发布者可见） -->
    <view class="card" wx:if="{{isOwner && applications.length > 0}}">
      <view class="section-title">📨 申请记录（{{applications.length}}条）</view>
      <view class="application-list">
        <view class="application-item" wx:for="{{applications}}" wx:key="id">
          <view class="app-header flex-between">
            <view class="flex-row">
              <image class="avatar-sm" src="{{item.applicantAvatar || '/images/default-item.png'}}" mode="aspectFill" />
              <view class="app-name">{{item.applicantName}}</view>
            </view>
            <view class="app-status app-status-{{item.status}}">
              {{item.status === 'pending' ? '待确认' : item.status === 'approved' ? '已送出' : '未选中'}}
            </view>
          </view>
          <view class="app-message">"{{item.message}}"</view>
          <!-- 发布者可见的确认按钮 -->
          <view wx:if="{{isOwner && item.status === 'pending' && !isCompleted}}"
            class="approve-btn" data-id="{{item.id}}" bindtap="approveApplication">
            确认送给TA
          </view>
        </view>
      </view>
    </view>

    <!-- 举报记录（仅发布者可见，可下架/忽略处理） -->
    <view class="card" wx:if="{{isOwner && reports.length > 0}}">
      <view class="section-title">🚨 举报记录（{{reports.length}}条）</view>
      <view class="application-list">
        <view class="application-item" wx:for="{{reports}}" wx:key="id" wx:for-item="report">
          <view class="app-header flex-between">
            <view class="app-message report-reason">"{{report.reason}}"</view>
            <view class="app-status {{report.status === 'handled' ? 'app-status-approved' : 'app-status-pending'}}">
              {{report.status === 'handled' ? (report.result === 'offline' ? '已下架' : '已忽略') : '待处理'}}
            </view>
          </view>
          <view class="report-time">{{report.createTimeStr}}</view>
          <view class="report-actions" wx:if="{{report.status === 'pending' && !isCompleted}}">
            <view class="report-action danger" data-action="offline" data-id="{{report.id}}" bindtap="handleReport">下架物品</view>
            <view class="report-action normal" data-action="ignore" data-id="{{report.id}}" bindtap="handleReport">忽略</view>
          </view>
        </view>
      </view>
    </view>

    <!-- P5：完成互评（物品已完成，本人是发布者或被选中的申请者，且未评价过） -->
    <view class="card" wx:if="{{isCompleted && !evaluated && isLoggedIn && (isOwner || (hasApplied && applyStatus === 'approved'))}}">
      <view class="section-title">⭐ 完成互评</view>
      <view class="eval-prompt">本次赠送已完成，评价一下对方吧，帮助大家了解靠谱的公益伙伴</view>
      <view class="eval-btn" bindtap="openEval">去评价 · 点亮星星</view>
    </view>
    <view class="card" wx:if="{{isCompleted && evaluated && isLoggedIn && (isOwner || (hasApplied && applyStatus === 'approved'))}}">
      <view class="section-title">⭐ 完成互评</view>
      <view class="eval-prompt eval-done">✅ 你已评价本次赠送，感谢反馈</view>
    </view>

    <!-- P2：猜你喜欢（同分类可领取，按热度推荐） -->
    <view class="card" wx:if="{{relatedItems.length > 0}}">
      <view class="section-title">💡 猜你喜欢</view>
      <view class="related-list">
        <view class="related-item" wx:for="{{relatedItems}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
          <image class="related-thumb" src="{{item.images[0] || '/images/default-item.png'}}" mode="aspectFill" />
          <view class="related-info flex-1">
            <view class="related-title text-ellipsis">{{item.title}}</view>
            <view class="related-meta">
              <view class="tag tag-{{item.category}}">{{item.categoryName}}</view>
              <text class="related-views">👁 {{item.viewCount || 0}}</text>
            </view>
          </view>
          <view class="related-arrow">›</view>
        </view>
      </view>
    </view>

    <!-- 底部占位 -->
    <view style="height: 140rpx;"></view>

  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <!-- 自己发布的 & 未完成（可编辑/下架/送出） -->
    <block wx:if="{{isOwner && !isCompleted}}">
      <button class="btn-outline bottom-btn" bindtap="goEdit">✏️ 编辑</button>
      <button wx:if="{{isOffline}}" class="btn-primary bottom-btn" bindtap="toggleOffline">🔼 上架</button>
      <button wx:else class="btn-outline bottom-btn" bindtap="toggleOffline">📴 下架</button>
      <button wx:if="{{!isOffline}}" class="btn-primary bottom-btn" bindtap="confirmComplete">✅ 送出</button>
    </block>

    <!-- 自己发布的 & 已完成状态 -->
    <block wx:if="{{isOwner && isCompleted}}">
      <button class="btn-disabled bottom-btn" disabled>
        已成功送出
      </button>
    </block>

    <!-- 发布者可见的删除 -->
    <block wx:if="{{isOwner}}">
      <button class="btn-danger bottom-btn" bindtap="deleteItem">
        🗑️ 删除
      </button>
    </block>

    <!-- 不是自己发布的 & 已下架 -->
    <block wx:if="{{!isOwner && isOffline}}">
      <button class="btn-disabled bottom-btn" disabled>
        已下架
      </button>
    </block>

    <!-- 不是自己发布的 & 可领取 -->
    <block wx:if="{{!isOwner && !isCompleted && !isOffline}}">
      <!-- 已登录：收藏 + 发起申请/交换 -->
      <view wx:if="{{isLoggedIn}}" class="fav-btn {{favorited ? 'fav-active' : ''}}" bindtap="toggleFavorite">
        {{favorited ? '❤️ 已收藏' : '🤍 收藏'}}
      </view>
      <!-- 已申请：按钮置灰，不可重复申请 -->
      <button wx:if="{{isLoggedIn && hasApplied}}" class="btn-disabled bottom-btn" disabled>
        {{applyStatus === 'approved' ? '✅ 申请已通过' : applyStatus === 'rejected' ? '😢 申请未通过' : '⏳ 已申请 · 待处理'}}
      </button>
      <button wx:elif="{{isLoggedIn}}" class="btn-primary bottom-btn" bindtap="openApply">
        🙋 我要申请
      </button>
      <!-- 未登录：游客只读，引导登录后才能交换 -->
      <button wx:else class="btn-outline bottom-btn" bindtap="goLogin">
        🔐 登录后可申请
      </button>
    </block>

    <!-- 不是自己发布的 & 已完成：仍可收藏 -->
    <block wx:if="{{!isOwner && isCompleted}}">
      <view wx:if="{{isLoggedIn}}" class="fav-btn {{favorited ? 'fav-active' : ''}}" bindtap="toggleFavorite">
        {{favorited ? '❤️ 已收藏' : '🤍 收藏'}}
      </view>
      <button class="btn-disabled bottom-btn" disabled>
        已被他人领取
      </button>
    </block>

    <!-- 消息入口（登录用户可见） -->
    <view wx:if="{{isLoggedIn}}" class="msg-btn" bindtap="openConversation">
      💬 消息
    </view>

    <!-- 举报按钮（仅登录用户可见，游客只读） -->
    <view wx:if="{{isLoggedIn}}" class="report-btn" bindtap="openReport">
      ⚠️ 举报
    </view>
  </view>

  <!-- 申请弹窗 -->
  <view class="modal-overlay" wx:if="{{showApplyModal}}" catchtap="closeApply">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">申请领取</view>
      <view class="modal-subtitle">请简要说明您需要此物品的原因</view>
      <textarea class="modal-textarea" placeholder="写一段话给发布者吧~（如：我是XX专业的学生，正需要这本书...）"
        value="{{applyMessage}}" bindinput="onApplyMessageInput" maxlength="200" />
      <view class="modal-buttons">
        <button class="modal-btn-cancel" bindtap="closeApply">取消</button>
        <button class="modal-btn-confirm" bindtap="submitApply">提交申请</button>
      </view>
    </view>
  </view>

  <!-- 举报弹窗 -->
  <view class="modal-overlay" wx:if="{{showReportModal}}" catchtap="closeReport">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">举报物品</view>
      <view class="modal-subtitle">如发现违规物品，请填写举报理由</view>
      <textarea class="modal-textarea" placeholder="请描述举报原因（必填）"
        value="{{reportReason}}" bindinput="onReportReasonInput" maxlength="300" />
      <view class="modal-buttons">
        <button class="modal-btn-cancel" bindtap="closeReport">取消</button>
        <button class="modal-btn-confirm" style="background-color: #f44336;" bindtap="submitReport">提交举报</button>
      </view>
    </view>
  </view>

  <!-- 评价弹窗（P5） -->
  <view class="modal-overlay" wx:if="{{showEvalModal}}" catchtap="closeEval">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">评价对方</view>
      <view class="modal-subtitle">为本次赠送的对方点个星吧</view>
      <view class="star-row">
        <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
          class="star {{evalRating >= item ? 'star-on' : ''}}"
          data-star="{{item}}" bindtap="onEvalRating">{{evalRating >= item ? '★' : '☆'}}</view>
      </view>
      <textarea class="modal-textarea" placeholder="写一句评价（选填，如：靠谱的同学，交接很顺利~）"
        value="{{evalComment}}" bindinput="onEvalComment" maxlength="200" />
      <view class="modal-buttons">
        <button class="modal-btn-cancel" bindtap="closeEval">取消</button>
        <button class="modal-btn-confirm" bindtap="submitEvaluation" loading="{{submittingEval}}" disabled="{{submittingEval}}">提交评价</button>
      </view>
    </view>
  </view>

</view>
