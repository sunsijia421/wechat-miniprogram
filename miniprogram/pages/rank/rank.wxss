/* 公益排行榜 */
.container {
  padding: 20rpx;
  box-sizing: border-box;
}

.rank-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  border: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.rank-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 14px;
  color: #666;
  border-radius: 12rpx;
}

.rank-tab.active {
  background: linear-gradient(135deg, #43A047, #5CB85C);
  color: #fff;
  font-weight: 600;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #f0f0f0;
}

.rank-item.me {
  border-color: #4CAF50;
  background: #f6fff6;
}

.rank-no {
  width: 56rpx;
  font-size: 24px;
  text-align: center;
  flex-shrink: 0;
}

.rank-no.top {
  font-size: 28px;
}

.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin: 0 16rpx;
  flex-shrink: 0;
}

.rank-info {
  min-width: 0;
}

.rank-name {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}

.me-tag {
  display: inline-block;
  background: #4CAF50;
  color: #fff;
  font-size: 10px;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  margin-left: 10rpx;
  vertical-align: middle;
}

.rank-detail {
  font-size: 12px;
  color: #999;
  margin-top: 6rpx;
}

.rank-points {
  font-size: 16px;
  font-weight: 700;
  color: #4CAF50;
  flex-shrink: 0;
}

.loading {
  text-align: center;
  color: #999;
  font-size: 13px;
  padding: 40rpx;
}
