/* 设置页（闲鱼风格） */
.container {
  padding: 20rpx;
  box-sizing: border-box;
}

.group {
  margin-bottom: 20rpx;
}

.group-title {
  font-size: 12px;
  color: #999;
  padding: 0 8rpx 12rpx;
}

.group-card {
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #f0f0f0;
  padding: 4rpx 24rpx;
}

.set-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 0;
}

.set-row.column {
  flex-direction: column;
  align-items: flex-start;
  padding: 20rpx 0;
}

.set-label {
  font-size: 15px;
  color: #333;
  width: 160rpx;
  flex-shrink: 0;
}

.set-input {
  flex: 1;
  font-size: 14px;
  color: #333;
  text-align: right;
}

.set-textarea {
  width: 100%;
  height: 140rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 14px;
  box-sizing: border-box;
  margin-top: 12rpx;
}

.set-value {
  flex: 1;
  font-size: 14px;
  color: #666;
  text-align: right;
}

.set-value.readonly {
  color: #999;
}

.set-value.accent {
  color: #4CAF50;
  font-weight: 700;
}

.level-text {
  color: #4CAF50;
  font-weight: 600;
}

.avatar-btn {
  position: relative;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.set-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #bbb;
}

.avatar-row {
  justify-content: space-between;
}

.avatar-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #4CAF50;
  border-radius: 50%;
  font-size: 18rpx;
  border: 3rpx solid #fff;
  box-sizing: border-box;
}

.set-divider {
  height: 1rpx;
  background: #f2f2f2;
}

.save-btn {
  background: linear-gradient(135deg, #43A047, #66BB6A);
  color: #fff;
  border-radius: 44rpx;
  font-size: 16px;
  font-weight: 600;
  margin-top: 12rpx;
}

.save-btn[disabled] {
  background: #ccc;
  color: #fff;
}

.logout-btn {
  background: #fff;
  color: #f44336;
  border-radius: 44rpx;
  font-size: 15px;
  margin-top: 20rpx;
  border: 1rpx solid #FFCDD2;
}
