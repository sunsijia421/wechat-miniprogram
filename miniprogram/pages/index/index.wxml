<!-- 首页 - 佳禾换物小站 -->
<view class="container">

  <!-- 微信隐私保护指引弹窗（合规必需） -->
  <view class="agreement-modal" wx:if="{{showPrivacy}}">
    <view class="agreement-content">
      <view class="agreement-title">隐私保护指引</view>
      <scroll-view scroll-y class="agreement-text">
        <text>我们非常重视您的个人信息与隐私保护。\n\n</text>
        <text>在使用本小程序前，请您阅读并同意《隐私保护指引》：\n\n</text>
        <text>1. 我们会申请您的位置信息（scope.userLocation），用于发布物品时标记位置与地图展示。\n\n</text>
        <text>2. 您发布的物品信息、头像与昵称将在平台内展示，用于公益流转匹配。\n\n</text>
        <text>3. 我们不会向第三方出售您的个人信息。\n\n</text>
        <text>4. 您可随时在「我的」中退出登录并清除本地数据。\n\n</text>
        <text>点击「同意并继续」即表示您已阅读并同意上述条款。</text>
      </scroll-view>
      <view class="agreement-buttons">
        <button class="btn-agree" bindtap="onAgreePrivacy">同意并继续</button>
      </view>
    </view>
  </view>

  <!-- 用户协议弹窗 -->
  <view class="agreement-modal" wx:if="{{showAgreement}}">
    <view class="agreement-content">
      <view class="agreement-title">🌿 公益互助公约</view>
      <scroll-view scroll-y class="agreement-text">
        <text>欢迎加入佳禾换物小站！\n\n</text>
        <text>1. 本平台仅用于校园内闲置物品的免费流转，禁止任何形式的金钱交易。\n\n</text>
        <text>2. 请如实描述物品状况，不得发布违禁物品（如烟酒、管制刀具等）。\n\n</text>
        <text>3. 物品流转由双方自行协商交接，本平台仅提供信息展示服务。\n\n</text>
        <text>4. 发布物品即视为同意无偿赠送给有需要的人。\n\n</text>
        <text>5. 以物易物需双方自愿协商，不得强制交易。\n\n</text>
        <text>6. 如发现违规行为，可通过举报功能反馈，我们致力于维护良好的公益氛围。\n\n</text>
        <text>7. 每次成功捐赠，您将获得10点公益积分。</text>
      </scroll-view>
      <view class="agreement-buttons">
        <button class="btn-disagree" bindtap="onDisagree">不同意</button>
        <button class="btn-agree" bindtap="onAgree">同意并继续</button>
      </view>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="login-prompt card" wx:if="{{!isLoggedIn && !showAgreement}}">
    <view class="login-tip">
      <text class="login-icon">👤</text>
      <text>请先授权登录后使用</text>
    </view>
    <button class="btn-primary login-btn" bindtap="onSetupProfileTap">授权登录</button>
  </view>

  <!-- 主内容（登录后显示） -->
  <block wx:if="{{isLoggedIn && !showAgreement}}">

    <!-- 统计面板 -->
    <view class="stats-panel">
      <view class="stats-row">
        <view class="stats-item">
          <view class="stats-number">{{completedCount}}</view>
          <view class="stats-label">件闲置物品获新生</view>
        </view>
        <view class="stats-divider"></view>
        <view class="stats-item">
          <view class="stats-number">{{availableCount}}</view>
          <view class="stats-label">件物品等待有缘人</view>
        </view>
      </view>
    </view>

    <!-- P3：公益公告栏 -->
    <view class="notice-bar" wx:if="{{notices.length > 0}}">
      <view class="notice-icon">📢</view>
      <swiper class="notice-swiper" vertical autoplay interval="4000" circular="{{false}}">
        <swiper-item wx:for="{{notices}}" wx:key="*this">
          <view class="notice-text">{{item}}</view>
        </swiper-item>
      </swiper>
    </view>

    <!-- P3：每日签到 -->
    <view class="checkin-card">
      <view class="checkin-left">
        <view class="checkin-title">
          📅 每日签到
          <text class="checkin-streak" wx:if="{{checkin.streak > 0}}">🔥 连续 {{checkin.streak}} 天</text>
        </view>
        <view class="checkin-week">
          <view class="checkin-day {{day.signed ? 'signed' : ''}} {{day.isToday ? 'today' : ''}}" wx:for="{{checkin.week}}" wx:key="date">
            <view class="checkin-day-dot">{{day.signed ? '✓' : ''}}</view>
            <view class="checkin-day-label">{{day.label}}</view>
          </view>
        </view>
      </view>
      <button class="checkin-btn {{checkin.signed ? 'done' : ''}}" bindtap="doCheckIn" disabled="{{checkin.signed}}">
        {{checkin.signed ? '今日已签' : '签到 +2'}}
      </button>
    </view>

    <!-- 视图切换按钮 -->
    <view class="view-toggle">
      <view class="toggle-btn {{viewMode === 'list' ? 'active' : ''}}" bindtap="switchViewMode">📋 列表视图</view>
      <view class="toggle-btn {{viewMode === 'map' ? 'active' : ''}}" bindtap="switchViewMode">🗺️ 地图视图</view>
    </view>

    <!-- 搜索栏（列表视图显示） -->
    <view class="search-bar" wx:if="{{viewMode === 'list'}}">
      <view class="search-input-wrap">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索物品名称" value="{{keyword}}"
          bindinput="onSearchInput" confirm-type="search" />
        <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
      </view>
    </view>

    <!-- P2：热门搜索词 -->
    <view class="hot-keywords" wx:if="{{viewMode === 'list' && hotKeywords.length > 0}}">
      <text class="hot-label">🔥 热门搜索</text>
      <view class="hot-keyword" wx:for="{{hotKeywords}}" wx:key="keyword" data-keyword="{{item.keyword}}" bindtap="onHotKeywordTap">
        {{item.keyword}}
      </view>
    </view>

    <!-- 仅看可换 切换 -->
    <view class="barter-toggle" wx:if="{{viewMode === 'list'}}">
      <view class="barter-toggle-item {{barterOnly ? 'active' : ''}}" bindtap="onBarterToggle">
        <text class="barter-check">{{barterOnly ? '✅' : '⬜'}}</text>
        <text>仅看可交换</text>
      </view>
    </view>

    <!-- 分类标签（列表视图显示） -->
    <scroll-view scroll-x class="category-tabs" wx:if="{{viewMode === 'list'}}">
      <view class="category-tab {{currentCategory === categoryKeys[index] ? 'active' : ''}}"
        wx:for="{{categories}}" wx:key="*this" wx:for-index="index" wx:for-item="cat"
        data-category="{{categoryKeys[index]}}"
        bindtap="onCategoryChange">
        {{cat}}
      </view>
    </scroll-view>

    <!-- 分类 + 搜索组合态提示 -->
    <view class="filter-banner" wx:if="{{viewMode === 'list' && (currentCategory !== 'all' || keyword)}}">
      <view class="filter-chip" wx:if="{{currentCategory !== 'all'}}" bindtap="clearCategory">
        分类：{{currentCategoryName}} <text class="chip-x">✕</text>
      </view>
      <view class="filter-chip" wx:if="{{keyword}}" bindtap="clearSearch">
        搜索：{{keyword}} <text class="chip-x">✕</text>
      </view>
      <view class="filter-clear-all" bindtap="clearAllFilters">清除全部</view>
    </view>

    <!-- 列表视图 -->
    <block wx:if="{{viewMode === 'list'}}">
      <!-- P2：热门物品榜（按热度排序，横滑卡片） -->
      <view class="hot-section" wx:if="{{hotItems.length > 0}}">
        <view class="hot-section-head">
          <text class="hot-section-title">🔥 热门物品</text>
          <text class="hot-section-sub">大家都在看</text>
        </view>
        <scroll-view scroll-x class="hot-scroll">
          <view class="hot-card" wx:for="{{hotItems}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
            <image class="hot-thumb" src="{{item.images[0] || '/images/default-item.png'}}" mode="aspectFill" />
            <view class="hot-title text-ellipsis">{{item.title}}</view>
            <view class="hot-meta">
              <text class="hot-views">👁 {{item.viewCount || 0}}</text>
              <text class="hot-heat">🔥 {{item.heat || 0}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view wx:if="{{displayItems.length === 0}}" class="empty-state">
        <view class="icon">📭</view>
        <view class="text">{{keyword ? '未找到相关物品' : '暂无物品'}}</view>
        <view class="text sub" wx:if="{{keyword}}">试试热门搜索：{{hotKeywords.length > 0 ? hotKeywords[0].keyword : ''}}</view>
        <view class="text sub" wx:else>去发布第一件物品吧~</view>
        <view class="hot-keyword" wx:if="{{keyword && hotKeywords.length > 0}}" data-keyword="{{hotKeywords[0].keyword}}" bindtap="onHotKeywordTap">🔍 搜 "{{hotKeywords[0].keyword}}"</view>
      </view>

      <view class="item-list" wx:else>
        <view class="result-count" wx:if="{{keyword || currentCategory !== 'all'}}">
          共找到 {{displayItems.length}} 件相关物品
        </view>
        <view class="item-card card" wx:for="{{displayItems}}" wx:key="id"
          data-id="{{item.id}}" bindtap="onItemTap">
          <view class="item-card-row">
            <image class="item-thumb" src="{{item.images[0] || '/images/default-item.png'}}" mode="aspectFill" />
            <view class="item-info flex-1">
              <view class="item-title text-ellipsis">
                <text wx:for="{{item.titleSegments}}" wx:key="k" wx:for-item="seg" class="{{seg.hl ? 'hl' : ''}}">{{seg.text}}</text>
              </view>
              <view class="item-desc text-ellipsis-2">{{item.description}}</view>
              <view class="item-meta">
                <view class="tag tag-{{item.category}}">{{item.categoryName}}</view>
                <view wx:if="{{item.allowBarter}}" class="tag-barter">🔄 可交换</view>
                <text class="item-publisher">{{item.publisherNickName || '匿名'}}</text>
                <text class="item-time">{{item.createTimeStr}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{displayItems.length > 0}}">
        {{hasMore ? '上拉加载更多' : '—— 已显示全部物品 ——'}}
      </view>
    </block>

    <!-- 地图视图 -->
    <block wx:if="{{viewMode === 'map'}}">
      <map
        class="map-view"
        latitude="{{mapLat}}"
        longitude="{{mapLng}}"
        scale="{{mapScale}}"
        markers="{{mapMarkers}}"
        bindmarkertap="onMarkerTap"
        show-location="{{true}}"
      />
      <view class="map-tip" wx:if="{{mapMarkers.length === 0}}">
        <text>暂无带位置信息的物品</text>
      </view>
    </block>

  </block>

  <!-- P3：新手引导弹窗（首次登录后展示一次，可跳过） -->
  <view class="agreement-modal" wx:if="{{showGuide}}">
    <view class="agreement-content guide-content">
      <view class="guide-step-indicator">
        <view class="guide-dot {{guideStep === 1 ? 'active' : ''}}"></view>
        <view class="guide-dot {{guideStep === 2 ? 'active' : ''}}"></view>
        <view class="guide-dot {{guideStep === 3 ? 'active' : ''}}"></view>
      </view>
      <view class="guide-body">
        <view class="guide-icon" wx:if="{{guideStep === 1}}">🔍</view>
        <view class="guide-icon" wx:if="{{guideStep === 2}}">📦</view>
        <view class="guide-icon" wx:if="{{guideStep === 3}}">🙋</view>
        <view class="guide-title" wx:if="{{guideStep === 1}}">浏览闲置好物</view>
        <view class="guide-title" wx:if="{{guideStep === 2}}">发布闲置物品</view>
        <view class="guide-title" wx:if="{{guideStep === 3}}">申请领取</view>
        <view class="guide-desc" wx:if="{{guideStep === 1}}">逛逛首页，看看同学们在分享什么闲置好物，支持分类筛选和关键词搜索～</view>
        <view class="guide-desc" wx:if="{{guideStep === 2}}">点击底部"发布"，把闲置物品免费送出或交换，让资源流动起来～</view>
        <view class="guide-desc" wx:if="{{guideStep === 3}}">看到需要的物品，点击"我要申请"，写清理由等待发布者确认即可～</view>
      </view>
      <view class="agreement-buttons">
        <button class="btn-disagree" bindtap="onSkipGuide">{{guideStep === 3 ? '跳过' : '跳过'}}</button>
        <button class="btn-agree" bindtap="onNextGuide">{{guideStep === 3 ? '开始使用' : '下一步'}}</button>
      </view>
    </view>
  </view>

  <!-- 完善公益身份弹窗（头像 + 昵称） -->
  <view class="agreement-modal" wx:if="{{showProfileSetup}}">
    <view class="agreement-content">
      <view class="agreement-title">完善公益身份</view>
      <view class="profile-setup">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{avatarUrl}}" class="setup-avatar" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="setup-avatar-placeholder">点击选择头像</view>
        </button>
        <input class="nickname-input" type="nickname" placeholder="请输入昵称" value="{{nickName}}" bindinput="onNicknameInput" />
      </view>
      <view class="agreement-buttons">
        <button class="btn-disagree" bindtap="onSkipProfile">跳过</button>
        <button class="btn-agree" bindtap="onSaveProfile">保存</button>
      </view>
    </view>
  </view>

</view>
