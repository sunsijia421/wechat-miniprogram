/* 首页样式 */
.container {
  padding-bottom: 40rpx;
}

/* ========== 协议弹窗 ========== */
.agreement-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agreement-content {
  background-color: #ffffff;
  border-radius: 16rpx;
  width: 85%;
  max-height: 75%;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
}

.agreement-title {
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  color: #4CAF50;
}

.agreement-text {
  flex: 1;
  max-height: 500rpx;
  font-size: 13px;
  line-height: 1.8;
  color: #555;
  margin-bottom: 30rpx;
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
}

.agreement-buttons {
  display: flex;
  gap: 20rpx;
}

.btn-disagree {
  flex: 1;
  background-color: #f0f0f0;
  color: #666;
  border-radius: 40rpx;
  font-size: 15px;
  padding: 20rpx 0;
}

.btn-agree {
  flex: 1;
  background-color: #4CAF50;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 15px;
  padding: 20rpx 0;
}

/* ========== 登录提示 ========== */
.login-prompt {
  text-align: center;
  padding: 80rpx 30rpx;
  margin-top: 100rpx;
}

.login-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  font-size: 16px;
  color: #666;
}

.login-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.login-btn {
  width: 400rpx;
  margin: 0 auto;
  border-radius: 40rpx;
}

/* ========== 统计面板 ========== */
.stats-panel {
  background: linear-gradient(135deg, #43A047, #66BB6A);
  color: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stats-item {
  text-align: center;
  flex: 1;
}

.stats-number {
  font-size: 40px;
  font-weight: bold;
  color: #ffffff;
}

.stats-label {
  font-size: 13px;
  opacity: 0.9;
  margin-top: 8rpx;
}

.stats-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.4);
}

/* ========== 视图切换 ========== */
.view-toggle {
  display: flex;
  margin: 0 20rpx 16rpx;
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.toggle-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 36rpx;
  font-size: 14px;
  color: #666;
}

.toggle-btn.active {
  background-color: #4CAF50;
  color: #ffffff;
  font-weight: bold;
}

/* ========== 搜索栏 ========== */
.search-bar {
  padding: 12rpx 20rpx 4rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  height: 76rpx;
  background-color: #ffffff;
  border-radius: 38rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 14px;
  color: #333;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background-color: #e8e8e8;
  color: #888;
  font-size: 12px;
}

/* ========== 仅看可换切换 ========== */
.barter-toggle {
  padding: 0 20rpx 4rpx;
}

.barter-toggle-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  background-color: #ffffff;
  border: 2rpx solid #ececec;
  border-radius: 30rpx;
  font-size: 13px;
  color: #666;
  transition: all 0.15s ease;
}

.barter-toggle-item.active {
  background: linear-gradient(135deg, #43A047, #5CB85C);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.barter-check {
  font-size: 15px;
}

/* ========== 分类标签 ========== */
.category-tabs {
  white-space: nowrap;
  padding: 10rpx 20rpx;
  margin-bottom: 10rpx;
}

.category-tab {
  display: inline-block;
  padding: 10rpx 30rpx;
  margin-right: 12rpx;
  background-color: #ffffff;
  border-radius: 30rpx;
  font-size: 13px;
  color: #666;
  border: 2rpx solid #ececec;
  transition: all 0.15s ease;
}

.category-tab.active {
  background: linear-gradient(135deg, #43A047, #5CB85C);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

/* 可交换标签 */
.tag-barter {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 11px;
  background-color: #E8F5E9;
  color: #2E7D32;
  border: 1rpx solid #C8E6C9;
}

/* ========== 组合筛选态提示 ========== */
.filter-banner {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 10rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  background-color: #E8F5E9;
  color: #2E7D32;
  border-radius: 26rpx;
  font-size: 13px;
}

.chip-x {
  font-size: 12px;
  opacity: 0.7;
}

.filter-clear-all {
  margin-left: auto;
  font-size: 13px;
  color: #999;
  padding: 8rpx 4rpx;
}

/* ========== 物品列表 ========== */
.item-list {
  padding: 0 20rpx;
}

.item-card {
  margin: 0 0 16rpx 0;
  padding: 20rpx;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.item-card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.item-card-row {
  display: flex;
  align-items: center;
}

.item-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #eef3ee, #e3ebe3);
  flex-shrink: 0;
}

.item-info {
  min-width: 0;
}

.item-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

/* 搜索关键词高亮 */
.item-title .hl {
  color: #FF6F00;
  background-color: #FFF3E0;
  border-radius: 4rpx;
  padding: 0 2rpx;
}

.item-desc {
  font-size: 13px;
  color: #999;
  margin-bottom: 12rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.item-publisher {
  font-size: 11px;
  color: #999;
}

.item-time {
  font-size: 11px;
  color: #ccc;
}

/* ========== 地图视图 ========== */
.map-view {
  width: 100%;
  height: 700rpx;
  margin-top: 10rpx;
}

.map-tip {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 14px;
}

/* ========== 空状态 ========== */
.sub {
  font-size: 12px;
  color: #bbb;
  margin-top: 8rpx;
}

/* ========== 完善身份弹窗 ========== */
.profile-setup {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0 10rpx;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0 0 30rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #f0f0f0;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.setup-avatar {
  width: 140rpx;
  height: 140rpx;
}

.setup-avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #999;
  text-align: center;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 14px;
  box-sizing: border-box;
  text-align: center;
}
