/* 求购详情 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}
.wish-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.wish-title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.wish-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  background: #E8F5E9;
  color: #2E7D32;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.wish-status {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.wish-status.open {
  background: #FFF8E1;
  color: #F57F17;
}
.wish-status.done {
  background: #f0f0f0;
  color: #999;
}
.wish-desc {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}

.publisher-card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}
.pub-info {
  flex: 1;
}
.pub-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.pub-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #2E7D32;
  background: #E8F5E9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.offer-btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  border-radius: 48rpx;
  line-height: 2.6;
}
.offer-btn.disabled {
  background: #ccc;
}

/* 弹窗（复用通用样式） */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal-content {
  width: 620rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 30rpx 30rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
}
.modal-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}
.modal-textarea {
  width: 100%;
  height: 200rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.modal-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.modal-btn-cancel {
  flex: 1;
  background: #f0f0f0;
  color: #666;
  font-size: 28rpx;
  border-radius: 44rpx;
  line-height: 2.4;
}
.modal-btn-confirm {
  flex: 1;
  background: #4CAF50;
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
  line-height: 2.4;
}
