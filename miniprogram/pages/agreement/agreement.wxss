.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}
.doc-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
}
.doc-title {
  font-size: 20px;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}
.doc-section {
  margin-bottom: 28rpx;
}
.doc-h {
  font-size: 15px;
  font-weight: 600;
  color: #4CAF50;
  margin-bottom: 12rpx;
}
.doc-p {
  font-size: 13px;
  color: #555;
  line-height: 1.8;
  margin-bottom: 6rpx;
}
.doc-footer {
  text-align: center;
  font-size: 11px;
  color: #bbb;
  margin-top: 40rpx;
}
