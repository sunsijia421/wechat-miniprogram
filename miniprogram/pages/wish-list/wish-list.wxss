/* 心愿求购 */
.container {
  padding: 20rpx 24rpx 160rpx;
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

.wish-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}
.wish-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 14rpx 0;
  border-radius: 12rpx;
}
.wish-tab.active {
  background: #4CAF50;
  color: #fff;
  font-weight: 600;
}

.cat-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.cat-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}
.cat-chip {
  padding: 10rpx 26rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #555;
}
.cat-chip.active {
  background: #E8F5E9;
  color: #2E7D32;
  font-weight: 600;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}
.empty-icon {
  font-size: 80rpx;
}
.empty-text {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #333;
}
.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.wish-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.wish-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.wish-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wish-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.wish-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
.wish-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.wish-publisher {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.wish-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
}
.wish-nick {
  font-size: 24rpx;
  color: #555;
}
.wish-time {
  font-size: 22rpx;
  color: #999;
}
.wish-status {
  font-size: 22rpx;
}
.wish-status.open {
  color: #2E7D32;
}
.wish-status.done {
  color: #999;
}
.wish-close {
  font-size: 24rpx;
  color: #f44336;
  padding: 6rpx 12rpx;
}

.list-end {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  padding: 24rpx 0;
}

.publish-fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  color: #fff;
  font-size: 28rpx;
  padding: 22rpx 40rpx;
  border-radius: 48rpx;
  box-shadow: 0 6rpx 20rpx rgba(76, 175, 80, 0.4);
}
