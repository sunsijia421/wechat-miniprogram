<!-- 心愿求购（P6） -->
<view class="container">

  <!-- 顶部 Tab -->
  <view class="wish-tabs">
    <view class="wish-tab {{tab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="switchTab">全部求购</view>
    <view class="wish-tab {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchTab">我的求购</view>
  </view>

  <!-- 分类横滑（全部求购时） -->
  <scroll-view class="cat-scroll" scroll-x wx:if="{{tab === 'all'}}" enhanced show-scrollbar="{{false}}">
    <view class="cat-row">
      <view wx:for="{{categories}}" wx:key="*this"
        class="cat-chip {{currentCategory === categoryKeys[index] ? 'active' : ''}}"
        data-index="{{index}}" bindtap="onCategoryChange">{{item}}</view>
    </view>
  </scroll-view>

  <!-- 全部求购列表 -->
  <block wx:if="{{tab === 'all'}}">
    <view class="empty" wx:if="{{isEmpty && !loading}}">
      <view class="empty-icon">🙋</view>
      <view class="empty-text">还没有求购需求</view>
      <view class="empty-sub">发布心愿，让闲置找到需要的人</view>
    </view>

    <view class="wish-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="wish-head">
        <view class="wish-title">{{item.title}}</view>
        <view class="wish-tag tag-{{item.category}}">{{item.categoryName}}</view>
      </view>
      <view class="wish-desc">{{item.descShort}}</view>
      <view class="wish-foot">
        <view class="wish-publisher">
          <image class="wish-avatar" src="{{item.avatarUrl || '/images/default-item.png'}}" mode="aspectFill" />
          <text class="wish-nick">{{item.nickName || '同学'}}</text>
        </view>
        <view class="wish-time">{{item.createTimeStr}}</view>
      </view>
    </view>

    <view class="list-end" wx:if="{{list.length > 0 && !hasMore}}">没有更多了</view>
    <view class="list-end" wx:if="{{loading}}">加载中...</view>
  </block>

  <!-- 我的求购 -->
  <block wx:if="{{tab === 'mine'}}">
    <view class="empty" wx:if="{{mine.length === 0}}">
      <view class="empty-icon">📝</view>
      <view class="empty-text">你还没有发布求购</view>
      <view class="empty-sub">点击右下角按钮发布第一条心愿</view>
    </view>

    <view class="wish-card" wx:for="{{mine}}" wx:key="id">
      <view class="wish-head">
        <view class="wish-title">{{item.title}}</view>
        <view class="wish-tag tag-{{item.category}}">{{item.categoryName}}</view>
      </view>
      <view class="wish-desc">{{item.description}}</view>
      <view class="wish-foot">
        <view class="wish-status {{item.statusClass}}">{{item.statusText}} · {{item.createTimeStr}}</view>
        <view class="wish-close" wx:if="{{item.status === 'open'}}" data-id="{{item.id}}" catchtap="closeWish">标记已满足</view>
      </view>
    </view>
  </block>

  <!-- 发布按钮 -->
  <view class="publish-fab" bindtap="goPublish">+ 发布求购</view>

</view>
