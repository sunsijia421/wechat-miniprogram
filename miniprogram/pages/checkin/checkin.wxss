.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部统计 */
.stat-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #43A047, #66BB6A);
  border-radius: 20rpx;
  padding: 36rpx 0;
  margin-bottom: 24rpx;
  color: #fff;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
}
.stat-label {
  font-size: 12px;
  opacity: 0.9;
  margin-top: 8rpx;
}
.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.3);
}

/* 月份切换 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.month-nav {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: #666;
}
.month-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
  margin: 0 40rpx;
}

/* 月历 */
.cal-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.cal-week {
  display: flex;
  margin-bottom: 12rpx;
}
.cal-week-cell {
  flex: 1;
  text-align: center;
  font-size: 12px;
  color: #999;
  padding: 8rpx 0;
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  width: 14.28%;
  display: flex;
  justify-content: center;
  padding: 6rpx 0;
  box-sizing: border-box;
}
.cal-day {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f7f7f7;
  position: relative;
}
.cal-day-num {
  font-size: 14px;
  color: #333;
  line-height: 1;
}
.cal-day-mark {
  font-size: 14rpx;
  color: #4CAF50;
  line-height: 1;
  margin-top: 2rpx;
}
.cal-day.signed {
  background: linear-gradient(135deg, #43A047, #66BB6A);
}
.cal-day.signed .cal-day-num {
  color: #fff;
}
.cal-day.signed .cal-day-mark {
  color: #fff;
}
.cal-day.today {
  box-shadow: 0 0 0 3rpx rgba(76, 175, 80, 0.3);
}
.cal-day.future .cal-day-num {
  color: #ccc;
}

/* 签到按钮 */
.checkin-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #43A047, #66BB6A);
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(76, 175, 80, 0.3);
}
.checkin-btn.done {
  background: #eee;
  color: #999;
  box-shadow: none;
}

/* 奖励规则 */
.rule-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
}
.rule-title {
  font-size: 15px;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.rule-item {
  font-size: 13px;
  color: #666;
  line-height: 2;
}
