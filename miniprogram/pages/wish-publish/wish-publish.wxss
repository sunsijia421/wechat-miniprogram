/* 发布求购 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}
.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin: 20rpx 0 12rpx;
}
.form-label:first-child {
  margin-top: 0;
}
.form-input {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.form-picker {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}
.form-textarea {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
}
.form-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
}

.submit-btn {
  margin-top: 40rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 30rpx;
  border-radius: 48rpx;
  line-height: 2.6;
}
