.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

/* 顶部物品条 */
.top-bar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.item-bar {
  background: #4CAF50;
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 24rpx;
  flex: 1;
  min-width: 0;
}
.item-bar-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* P7：拉黑按钮 */
.block-btn {
  background: #f5f5f5;
  color: #999;
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  flex-shrink: 0;
}

.block-btn.blocked {
  color: #f44336;
  background: #FFEBEE;
}

/* P7：拉黑状态横幅 */
.block-banner {
  background: #FFEBEE;
  color: #f44336;
  font-size: 24rpx;
  text-align: center;
  padding: 12rpx 24rpx;
  flex-shrink: 0;
}

/* 消息滚动区 */
.msg-scroll {
  flex: 1;
  box-sizing: border-box;
}
.msg-list {
  padding: 24rpx;
  box-sizing: border-box;
}
.msg-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.msg-item.mine {
  flex-direction: row-reverse;
}
.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}
.msg-bubble {
  max-width: 62%;
  margin: 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  position: relative;
}
.msg-item.theirs .msg-bubble {
  background: #fff;
  border-top-left-radius: 4rpx;
}
.msg-item.mine .msg-bubble {
  background: #4CAF50;
  color: #fff;
  border-top-right-radius: 4rpx;
}
.msg-content {
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}
.msg-time {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 6rpx;
}
.msg-item.mine .msg-time {
  color: rgba(255, 255, 255, 0.7);
  text-align: right;
}
.msg-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
.msg-loading {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  flex-shrink: 0;
  flex-wrap: wrap;
}
.send-limit-tip {
  width: 100%;
  text-align: center;
  font-size: 22rpx;
  color: #FF9800;
  background: #FFF8E1;
  border-radius: 24rpx;
  padding: 8rpx 0;
  margin-bottom: 12rpx;
}
.msg-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.send-btn {
  margin-left: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
}
.send-btn[disabled] {
  background: #c8e6c9;
  color: #fff;
}
