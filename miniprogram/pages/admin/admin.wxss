/* 举报管理页样式 */
.container {
  padding: 20rpx;
  padding-bottom: 60rpx;
}

.admin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10rpx 6rpx 20rpx;
}

.admin-title {
  font-size: 20px;
  font-weight: bold;
  color: #333;
}

.admin-count {
  font-size: 13px;
  color: #999;
}

.admin-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.back-user-btn {
  font-size: 13px;
  color: #4a90d9;
  padding: 6rpx 16rpx;
  border: 1px solid #4a90d9;
  border-radius: 24rpx;
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.report-card {
  margin: 0;
}

.report-head {
  margin-bottom: 12rpx;
}

.report-item-title {
  flex: 1;
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-reason-text {
  font-size: 14px;
  color: #555;
  line-height: 1.7;
  padding: 12rpx 16rpx;
  background-color: #fff8f8;
  border-radius: 8rpx;
}

.report-meta {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #bbb;
  margin-top: 12rpx;
}

.report-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.report-action {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 26rpx;
  font-size: 13px;
}

.report-action.danger {
  background-color: #f44336;
  color: #ffffff;
}

.report-action.normal {
  background-color: #f0f0f0;
  color: #666;
}

/* 状态标签 */
.status-tag {
  font-size: 11px;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.status-pending {
  background-color: #FFF3E0;
  color: #FF9800;
}

.status-handled {
  background-color: #E8F5E9;
  color: #4CAF50;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-state .text {
  font-size: 14px;
  color: #999;
}

.empty-state .sub {
  font-size: 12px;
  color: #bbb;
  margin-top: 8rpx;
}

.back-btn {
  width: 300rpx;
  margin-top: 40rpx;
  border-radius: 40rpx;
}
