/* 举报管理页样式 */
.container {
  padding: 20rpx;
  padding-bottom: 60rpx;
}

.admin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10rpx 6rpx 20rpx;
}

.admin-title {
  font-size: 20px;
  font-weight: bold;
  color: #333;
}

.admin-count {
  font-size: 13px;
  color: #999;
}

.admin-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.back-user-btn {
  font-size: 13px;
  color: #4a90d9;
  padding: 6rpx 16rpx;
  border: 1px solid #4a90d9;
  border-radius: 24rpx;
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.report-card {
  margin: 0;
}

.report-head {
  margin-bottom: 12rpx;
}

.report-item-title {
  flex: 1;
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-reason-text {
  font-size: 14px;
  color: #555;
  line-height: 1.7;
  padding: 12rpx 16rpx;
  background-color: #fff8f8;
  border-radius: 8rpx;
}

.report-meta {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #bbb;
  margin-top: 12rpx;
}

.report-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.report-action {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 26rpx;
  font-size: 13px;
}

.report-action.danger {
  background-color: #f44336;
  color: #ffffff;
}

.report-action.normal {
  background-color: #f0f0f0;
  color: #666;
}

/* 状态标签 */
.status-tag {
  font-size: 11px;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.status-pending {
  background-color: #FFF3E0;
  color: #FF9800;
}

.status-handled {
  background-color: #E8F5E9;
  color: #4CAF50;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-state .text {
  font-size: 14px;
  color: #999;
}

.empty-state .sub {
  font-size: 12px;
  color: #bbb;
  margin-top: 8rpx;
}

.back-btn {
  width: 300rpx;
  margin-top: 40rpx;
  border-radius: 40rpx;
}

/* ========== 管理后台 Tab ========== */
.admin-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 8rpx;
  border: 1rpx solid #f0f0f0;
}
.admin-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 14px;
  color: #666;
  border-radius: 12rpx;
}
.admin-tab.active {
  background: linear-gradient(135deg, #43A047, #5CB85C);
  color: #fff;
  font-weight: 600;
}

/* 数据总览 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.stat-card {
  flex: 1 1 150px;
  min-width: 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  border: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}
.stat-icon {
  font-size: 36rpx;
}
.stat-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-top: 8rpx;
}
.stat-label {
  font-size: 12px;
  color: #999;
  margin-top: 4rpx;
}

/* P2：图表卡片 */
.chart-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  border: 1rpx solid #f0f0f0;
}
.chart-title {
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}
.chart-card ec-canvas {
  width: 100%;
  height: 380rpx;
  display: block;
}

/* 管理搜索 */
.admin-search {
  margin-bottom: 20rpx;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  border: 1rpx solid #f0f0f0;
}
.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 14px;
}
.search-clear {
  padding: 0 8rpx;
  color: #bbb;
  font-size: 24rpx;
}
.filter-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.filter-chip {
  padding: 8rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  font-size: 12px;
  color: #666;
  border: 1rpx solid #eee;
}
.filter-chip.active {
  background: #E8F5E9;
  color: #43A047;
  border-color: #43A047;
  font-weight: 600;
}

/* 物品卡片 */
.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.item-card {
  margin: 0;
}
.item-card-row {
  display: flex;
  align-items: center;
}
.item-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.item-info {
  min-width: 0;
}
.item-title {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}
.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}
.item-desc {
  font-size: 12px;
  color: #bbb;
  margin-top: 8rpx;
}
.item-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.mini-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 24rpx;
  font-size: 13px;
}
.mini-btn.danger {
  background: #f44336;
  color: #fff;
}
.mini-btn.warn {
  background: #FFF3E0;
  color: #FF9800;
}
.mini-btn.green {
  background: #E8F5E9;
  color: #43A047;
}

/* 用户列表 */
.user-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.user-card {
  display: flex;
  align-items: center;
  margin: 0;
}
.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.user-info {
  min-width: 0;
}
.user-name {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}
.user-meta {
  display: flex;
  gap: 16rpx;
  align-items: center;
  font-size: 12px;
  color: #999;
  margin-top: 8rpx;
}
.admin-tag {
  background: #E8F5E9;
  color: #43A047;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}
.ban-tag.banned {
  background: #FFEBEE;
  color: #f44336;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  color: #4a90d9;
  font-size: 13px;
  padding: 24rpx 0;
}

.loading {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx;
}
