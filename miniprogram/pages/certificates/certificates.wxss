/* 我的公益证书 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}
.empty-icon {
  font-size: 80rpx;
}
.empty-text {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #333;
}
.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.cert-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.cert-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}
.cert-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.cert-title {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cert-no {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #4e7a52;
}
.cert-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
}
.cert-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 12rpx;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  padding: 20rpx 0 40rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.cert-modal {
  width: 640rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-sizing: border-box;
}
.cert-canvas {
  width: 600rpx;
  height: 800rpx;
  display: block;
  margin: 0 auto;
  border-radius: 8rpx;
}
.cert-btns {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.btn-save {
  width: 100%;
  background: #4CAF50;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  line-height: 2.4;
}
.btn-close {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999;
  padding: 12rpx 40rpx;
}
