/* 个人中心样式 */
.container {
  padding-bottom: 40rpx;
}

/* ========== 用户卡片 ========== */
.user-card {
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.user-bg {
  height: 120rpx;
  background: linear-gradient(135deg, #43A047, #66BB6A);
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -60rpx;
  padding-bottom: 20rpx;
}

.user-info .avatar-lg {
  border: 6rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.user-name {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-top: 16rpx;
}

.openid-debug {
  font-size: 11px;
  color: #999;
  margin-top: 10rpx;
  padding: 0 20rpx;
  word-break: break-all;
  text-align: center;
}

.user-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.user-stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 28px;
  font-weight: bold;
  color: #4CAF50;
}

.stat-label {
  font-size: 12px;
  color: #999;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 50rpx;
  background-color: #f0f0f0;
}

/* ========== Tab 切换 ========== */
.tab-bar {
  display: flex;
  margin: 0 20rpx 16rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 15px;
  color: #666;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s;
}

.tab-item.active {
  color: #4CAF50;
  font-weight: bold;
  border-bottom-color: #4CAF50;
  background-color: #f9fdf9;
}

/* ========== 物品列表 ========== */
.item-list {
  padding: 0 20rpx;
}

.item-card {
  margin: 0 0 16rpx 0;
  padding: 20rpx;
  transition: transform 0.12s ease;
}

.item-card:active {
  transform: scale(0.985);
}

.item-card-row {
  display: flex;
  align-items: center;
}

.item-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: #f0f0f0;
  flex-shrink: 0;
}

.item-info {
  min-width: 0;
}

.item-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.item-desc {
  font-size: 13px;
  color: #999;
  margin-bottom: 12rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* ========== 设置区域 ========== */
.settings-area {
  margin: 40rpx 20rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 15px;
  color: #333;
  transition: background-color 0.12s ease;
}

.setting-item:active {
  background-color: #f7f7f7;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:last-child {
  color: #f44336;
}

.setting-arrow {
  font-size: 22px;
  color: #ccc;
}

/* ========== 登录提示 ========== */
.login-prompt {
  margin-top: 100rpx;
  text-align: center;
  padding: 80rpx 30rpx;
}

/* ========== 管理员验证弹窗 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 30rpx 30rpx;
  width: 100%;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 13px;
  color: #999;
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 14px;
  box-sizing: border-box;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btn-cancel {
  flex: 1;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 30rpx;
  font-size: 15px;
}

.modal-btn-confirm {
  flex: 2;
  background-color: #4CAF50;
  color: #ffffff;
  border-radius: 30rpx;
  font-size: 15px;
}

/* ========== 我举报的列表 ========== */
.report-card {
  margin: 0 0 16rpx 0;
}

.report-head {
  margin-bottom: 12rpx;
}

.report-item-title {
  flex: 1;
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-reason-text {
  font-size: 14px;
  color: #555;
  line-height: 1.7;
  padding: 12rpx 16rpx;
  background-color: #fff8f8;
  border-radius: 8rpx;
}

.report-meta {
  display: flex;
  justify-content: flex-end;
  font-size: 12px;
  color: #bbb;
  margin-top: 12rpx;
}

.status-tag {
  font-size: 11px;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.status-pending {
  background-color: #FFF3E0;
  color: #FF9800;
}

.status-handled {
  background-color: #E8F5E9;
  color: #4CAF50;
}
