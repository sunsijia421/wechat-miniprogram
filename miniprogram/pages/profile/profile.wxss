/* 个人中心（闲鱼风格） */
.container {
  padding: 20rpx 20rpx 60rpx;
  box-sizing: border-box;
}

/* ========== 顶部用户信息区 ========== */
.user-header {
  background: linear-gradient(135deg, #43A047, #66BB6A);
  border-radius: 20rpx;
  padding: 36rpx 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(76, 175, 80, 0.25);
}

.user-top {
  display: flex;
  align-items: center;
}

.user-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.user-caret {
  font-size: 18px;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 6rpx;
}

.user-settings {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.95);
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}

.user-header .avatar-lg {
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

.user-id-box {
  margin-left: 24rpx;
  min-width: 0;
}

.user-name {
  font-size: 20px;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}
.user-title-badge {
  font-size: 12px;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.25);
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
}

.user-account {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
  word-break: break-all;
  max-width: 480rpx;
}

/* 积分 / 捐赠并排 */
.user-stats {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 16rpx;
  padding: 18rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 30px;
  font-weight: 700;
  color: #ffffff;
}

.stat-label {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.35);
}

/* P1：等级徽章 + 进度条 */
.level-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 11px;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}
.level-progress {
  width: 160rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  margin: 10rpx auto 0;
  overflow: hidden;
}
.level-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #FFF59D, #FFD54F);
  border-radius: 4rpx;
  transition: width 0.4s ease;
}
.level-next {
  font-size: 10px;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 6rpx;
}

/* ========== 分组区块 ========== */
.group {
  margin-bottom: 24rpx;
}

.group-title {
  font-size: 14px;
  color: #999;
  padding: 0 8rpx 12rpx;
}

.group-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

/* 入口行 */
.entry-row {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.12s ease;
}

.entry-row:active {
  background-color: #f7f7f7;
}

.entry-row:last-child {
  border-bottom: none;
}

/* 分享按钮覆盖 button 默认样式 */
button.entry-row {
  width: auto;
  margin: 0;
  padding: 30rpx 28rpx;
  background: transparent;
  border-radius: 0;
  line-height: normal;
  text-align: left;
}
button.entry-row::after {
  border: none;
}

.entry-icon {
  font-size: 34rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.entry-label {
  flex: 1;
  font-size: 16px;
  color: #333;
  font-weight: 500;
}

.entry-count {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 12px;
  border-radius: 18rpx;
  text-align: center;
  margin-right: 12rpx;
  box-sizing: border-box;
}

.entry-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* ========== 展开列表 ========== */
.expand-list {
  background: #fafafa;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 8rpx 28rpx;
}

.expand-empty {
  padding: 24rpx 0;
  text-align: center;
  font-size: 13px;
  color: #bbb;
}

.entry-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.entry-item-info {
  min-width: 0;
  flex: 1;
}

.entry-item-title {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}

.entry-item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.entry-item-time {
  font-size: 12px;
  color: #bbb;
}

/* ========== 状态标签（举报） ========== */
.status-tag {
  font-size: 11px;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.status-pending {
  background-color: #FFF3E0;
  color: #FF9800;
}

.status-handled {
  background-color: #E8F5E9;
  color: #4CAF50;
}

/* ========== 登录提示 ========== */
.login-prompt {
  margin-top: 100rpx;
  text-align: center;
  padding: 80rpx 30rpx;
}
