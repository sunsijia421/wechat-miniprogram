<!-- 个人中心（闲鱼风格） -->
<view class="container">

  <!-- 未登录 -->
  <view class="login-prompt card" wx:if="{{!userInfo}}">
    <view class="empty-state">
      <view class="icon">🔐</view>
      <view class="text">请先在首页授权登录</view>
    </view>
  </view>

  <!-- 已登录 -->
  <block wx:if="{{userInfo}}">

    <!-- 顶部用户信息区（闲鱼风格：点击进个人主页，右侧设置入口） -->
    <view class="user-header">
      <view class="user-top">
        <view class="user-main" bindtap="goUserHome">
          <image class="avatar-lg" src="{{userInfo.avatarUrl || '/images/default-item.png'}}" mode="aspectFill" />
          <view class="user-id-box">
            <view class="user-name">{{userInfo.nickName || '公益参与者'}} <text class="user-caret">›</text></view>
            <view class="user-account" wx:if="{{shortOpenid}}">账号：{{shortOpenid}}</view>
          </view>
        </view>
        <view class="user-settings" bindtap="goSettings">⚙️ 设置</view>
      </view>
      <!-- 积分 / 捐赠并排 + 等级徽章（P1） -->
      <view class="user-stats">
        <view class="stat-item" bindtap="goPointLogs">
          <view class="level-badge">{{level.icon}} {{level.name}}</view>
          <view class="stat-num">{{userInfo.points || 0}}</view>
          <view class="stat-label">公益积分 ›</view>
          <view class="level-progress">
            <view class="level-progress-bar" style="width: {{level.progress}}%;"></view>
          </view>
          <view class="level-next" wx:if="{{!level.isMax}}">距{{levelNextName}}还差{{level.nextMin - (userInfo.points || 0)}}分</view>
          <view class="level-next" wx:else>已达最高等级</view>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <view class="stat-num">{{userInfo.donateCount || 0}}</view>
          <view class="stat-label">捐赠次数</view>
        </view>
      </view>
    </view>

    <!-- ===== 我的交易（点击跳转独立列表页） ===== -->
    <view class="group">
      <view class="group-title">我的交易</view>
      <view class="group-card">
        <view class="entry-row" data-type="published" bindtap="goMyList">
          <view class="entry-icon">📦</view>
          <view class="entry-label">我发布的</view>
          <view class="entry-count" wx:if="{{publishCount > 0}}">{{publishCount}}</view>
          <view class="entry-arrow">›</view>
        </view>
        <view class="entry-row" data-type="applied" bindtap="goMyList">
          <view class="entry-icon">📋</view>
          <view class="entry-label">我申请的</view>
          <view class="entry-count" wx:if="{{appliedCount > 0}}">{{appliedCount}}</view>
          <view class="entry-arrow">›</view>
        </view>
        <view class="entry-row" data-type="favorites" bindtap="goMyList">
          <view class="entry-icon">❤️</view>
          <view class="entry-label">我收藏的</view>
          <view class="entry-count" wx:if="{{favoriteCount > 0}}">{{favoriteCount}}</view>
          <view class="entry-arrow">›</view>
        </view>
        <view class="entry-row" data-type="reported" bindtap="goMyList">
          <view class="entry-icon">🚨</view>
          <view class="entry-label">我举报的</view>
          <view class="entry-count" wx:if="{{reportCount > 0}}">{{reportCount}}</view>
          <view class="entry-arrow">›</view>
        </view>
      </view>
    </view>

    <!-- ===== 常用工具 ===== -->
    <view class="group">
      <view class="group-title">常用工具</view>
      <view class="group-card">
        <view class="entry-row" bindtap="goRank">
          <view class="entry-icon">🏆</view>
          <view class="entry-label">公益排行榜</view>
          <view class="entry-arrow">›</view>
        </view>
        <view class="entry-row" bindtap="goPointLogs">
          <view class="entry-icon">📜</view>
          <view class="entry-label">积分明细</view>
          <view class="entry-arrow">›</view>
        </view>
        <view class="entry-row" bindtap="goShop">
          <view class="entry-icon">🎁</view>
          <view class="entry-label">积分商城</view>
          <view class="entry-arrow">›</view>
        </view>
        <view class="entry-row" bindtap="goCertificates">
          <view class="entry-icon">🏅</view>
          <view class="entry-label">我的公益证书</view>
          <view class="entry-arrow">›</view>
        </view>
        <view class="entry-row" wx:if="{{isAdmin}}" bindtap="goAdmin">
          <view class="entry-icon">🛡️</view>
          <view class="entry-label">举报管理</view>
          <view class="entry-arrow">›</view>
        </view>
        <view class="entry-row" bindtap="goFeedback">
          <view class="entry-icon">💬</view>
          <view class="entry-label">意见反馈</view>
          <view class="entry-arrow">›</view>
        </view>
        <button class="entry-row share-entry" open-type="share">
          <view class="entry-icon">📢</view>
          <view class="entry-label">邀请好友加入</view>
          <view class="entry-arrow">›</view>
        </button>
        <view class="entry-row" bindtap="logout">
          <view class="entry-icon">🚪</view>
          <view class="entry-label">退出登录</view>
          <view class="entry-arrow">›</view>
        </view>
        <view class="entry-row" bindtap="clearAllData">
          <view class="entry-icon">🗑️</view>
          <view class="entry-label">清除所有数据</view>
          <view class="entry-arrow">›</view>
        </view>
      </view>
    </view>

  </block>

</view>
