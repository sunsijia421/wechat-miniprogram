<!-- 积分商城（第二批：爱心申领区 + 荣誉徽章） -->
<view class="container">

  <!-- 积分余额卡 -->
  <view class="points-card">
    <view class="points-label">我的公益积分</view>
    <view class="points-num">{{points}}</view>
    <view class="points-tip" bindtap="goPointLogs">积分怎么赚？查看积分明细 ›</view>
  </view>

  <!-- 爱心申领区（第二批） -->
  <view class="group">
    <view class="group-title">🧡 爱心申领区 · 积分申领物资</view>
    <view class="claim-desc">发布者可将物资放入申领专区，需要帮助的乡亲用公益积分申领，多人申请时高积分者优先。申领成功确认收到后扣除积分。</view>
    <view class="claim-list" wx:if="{{claimItems.length > 0}}">
      <view class="claim-card" wx:for="{{claimItems}}" wx:key="id" data-id="{{item.id}}" bindtap="goClaim">
        <image class="claim-img" src="{{item.image || '/images/default-item.png'}}" mode="aspectFill" />
        <view class="claim-info">
          <view class="claim-title">{{item.title}}</view>
          <view class="claim-meta">{{item.categoryName}}</view>
          <view class="claim-cost">⭐ {{item.pointCost || 10}} 积分申领</view>
        </view>
        <view class="claim-btn">去申领</view>
      </view>
    </view>
    <view class="claim-empty" wx:if="{{!loadingClaim && claimItems.length === 0}}">
      🌱 暂无申领物资，欢迎发布者将闲置放入申领专区
    </view>
  </view>

  <!-- 荣誉徽章 -->
  <view class="group">
    <view class="group-title">🏅 荣誉徽章 · 公益足迹</view>
    <view class="badge-grid">
      <view class="badge-card {{item.owned ? 'owned' : ''}}" wx:for="{{badges}}" wx:key="id">
        <view class="badge-icon">{{item.icon}}</view>
        <view class="badge-name">{{item.name}}</view>
        <view class="badge-desc">{{item.desc}}</view>
        <view class="badge-cost" wx:if="{{!item.owned}}">{{item.points}} 积分</view>
        <view class="badge-own" wx:else>✅ 已拥有</view>
        <view class="badge-btn" wx:if="{{!item.owned}}" data-id="{{item.id}}" bindtap="exchangeBadge">兑换</view>
      </view>
    </view>
  </view>

</view>
