/* 通用"我的"列表页 */
.container {
  padding: 20rpx;
  box-sizing: border-box;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  margin: 0;
  padding: 20rpx;
  display: flex;
  align-items: center;
}

.item-thumb {
  width: 130rpx;
  height: 130rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #eef3ee, #e3ebe3);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 15px;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  background: #F1F8E9;
  color: #4CAF50;
  font-size: 10px;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.status-tag {
  font-size: 10px;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.status-available {
  background: #E3F2FD;
  color: #1976D2;
}

.status-completed {
  background: #E8F5E9;
  color: #2E7D32;
}

.status-offline {
  background: #F3E5F5;
  color: #7B1FA2;
}

.status-pending {
  background: #FFF8E1;
  color: #B26A00;
}

/* P7：申请状态 */
.apply-waiting {
  background: #E3F2FD;
  color: #1976D2;
}

.apply-confirmed {
  background: #E8F5E9;
  color: #2E7D32;
}

.apply-missed {
  background: #FFEBEE;
  color: #E53935;
}

.apply-rejected {
  background: #f5f5f5;
  color: #999;
}

.status-handled {
  background: #E8F5E9;
  color: #2E7D32;
}

.item-reason {
  font-size: 12px;
  color: #999;
  margin-top: 10rpx;
}

.item-time {
  font-size: 11px;
  color: #bbb;
}

.item-arrow {
  font-size: 22px;
  color: #ccc;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.loading {
  text-align: center;
  color: #999;
  font-size: 13px;
  padding: 40rpx;
}
